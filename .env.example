# Copy this file to .env and change the secrets.

# Database: Neon Postgres (Vercel project -> Storage). Copy both lines from the
# database page (.env.local tab). On your laptop, add &schema=dev (or ?schema=dev
# if there is no "?") to both, so local testing stays apart from the live site.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&schema=dev"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&schema=dev"

# "sandbox" = test mode, no real money. A real partner adapter is added later.
PAYMENT_PROVIDER="sandbox"
SANDBOX_WEBHOOK_SECRET="change-me-sandbox-secret"

# Used to sign one-time codes and sessions. Use a long random value.
AUTH_SECRET="change-me-long-random-string"

# Phone numbers that get the admin page (comma separated).
ADMIN_PHONES="08030000000"

# Where the app is reachable (used for share links).
APP_URL="http://localhost:3000"

# WhatsApp. "test" = phone simulator at /dev/whatsapp, nothing sent to Meta.
# "cloud" = real WhatsApp Cloud API (fill in the values below from the Meta app).
WHATSAPP_MODE="test"
WHATSAPP_BOT_NUMBER="2340000000000"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE="deal_update"

# AI dispute mediator. "claude" = real suggestions (needs ANTHROPIC_API_KEY),
# "demo" = fixed-rule placeholder for testing, "off" = every dispute goes to a person.
# Left empty: claude if a key is set, demo in test mode, otherwise off.
MEDIATOR_MODE=""
ANTHROPIC_API_KEY=""
MEDIATOR_MODEL="claude-opus-5-5"
# Disputes above this amount (naira) always go to a person.
MEDIATOR_MAX_AUTO_NAIRA="1000000"

# Test mode only: sign in with any phone number and no code. Admin numbers still need a code.
# Never takes effect once a real payment provider is set.
QUICK_LOGIN="off"
